generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(TELECALLER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  followUps     FollowUp[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  activities    LeadActivity[]
  notes         Note[]

  @@index([role])
}

model Lead {
  id            String         @id @default(cuid())
  fullName      String
  country       String
  phone         String         @unique
  email         String         @unique
  treatment     Treatment
  description   String
  preferredCity String
  status        LeadStatus     @default(NEW)
  lostReason    String?
  assignedToId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  followUps     FollowUp[]
  assignedTo    User?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities    LeadActivity[]
  notes         Note[]

  @@index([status])
  @@index([country])
  @@index([treatment])
  @@index([createdAt])
  @@index([assignedToId, status])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  assignedToId String
  dueAt        DateTime
  completedAt  DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  assignedTo   User      @relation(fields: [assignedToId], references: [id])
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([assignedToId, dueAt, completedAt])
  @@index([leadId, dueAt])
}

enum UserRole {
  ADMIN
  TELECALLER
}

enum LeadStatus {
  NEW
  CONTACTED
  REPORTS_RECEIVED
  QUOTATION_SENT
  TRAVEL_PLANNED
  CONVERTED
  LOST
}

enum Treatment {
  CARDIAC
  ORTHOPEDIC
  ONCOLOGY
  IVF
  TRANSPLANT
  OTHER
}
